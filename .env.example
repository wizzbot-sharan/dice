# Telegram Bot Configuration
BOT_TOKEN=
TELEGRAM_WEBHOOK_PATH=/telegram
CHAT_ID= # Optional debug allowlist. Must be unset for production (500 clients).

# Database Configuration (Azure PostgreSQL)
DATABASE_URL=
DATABASE_POOL_MAX=10

# Playwright Configuration
LOCAL_MAX_CONCURRENT=5
APPLY_TIMEOUT_MINUTES=35
PREFLIGHT_MAX_CONCURRENT=2

# Authentication & Mailer (Microsoft Graph)
DICE_PASSWORD=
MAILER_CLIENT_ID=
MAILER_TENANT_ID=
MAILER_CLIENT_SECRET=
SENDER_EMAIL=

# Dashboard Server
DASHBOARD_PORT=3000
DASHBOARD_SECRET=

# Optional — screenshot upload skipped if any of these are missing
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_S3_BUCKET_NAME=
AWS_S3_BASE_PATH=dice-applications/screenshots

# Zoho Mail Reader admin (used by Global Sync + post-apply proof)
ZOHO_MAIL_READER_URL=https://zoho-mail-reader.onrender.com/
ZOHO_ADMIN_USERNAME=
ZOHO_ADMIN_PASSWORD=
