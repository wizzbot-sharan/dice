const fs = require('fs');
const pdfParse = require('pdf-parse');

const parsedResumeCache = new Map();

const SKILL_ALIASES = {
  react: ['react', 'reactjs', 'react.js', 'react native'],
  node: ['node', 'nodejs', 'node.js', 'express', 'express.js', 'nest', 'nestjs'],
  python: ['python', 'py', 'django', 'flask', 'fastapi'],
