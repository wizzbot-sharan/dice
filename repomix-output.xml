  const mockPool = {
    query: async (sql, params) => {
      if (sql.includes('INSERT INTO')) {
        savedData = params;
      }
      return { rows: [] };
    },
  };

  let promptCalled = false;
  const onPromptFallback = async ({ question, options }) => {
    promptCalled = true;
    return 'Option B';
  };

