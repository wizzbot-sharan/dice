.login-panel form { display: grid; gap: 16px; }
.button-group { display: flex; gap: 10px; flex-wrap: wrap; }
.link-button { background: none; border: none; padding: 0; color: var(--accent-orange); font-size: 13px; cursor: pointer; text-decoration: underline; }
.info-message { color: var(--pill-green-txt); background: var(--pill-green-bg); border: 1px solid #10b981; padding: 10px; border-radius: 6px; }
.error { color: var(--pill-red-txt); font-size: 13px; margin: 0; }

.margin-top { margin-top: 16px; }
.table-responsive { overflow-x: auto; }

/* Navigation Action Buttons (Copy Link & Show QR) */
.nav-action-btn {
  border: var(--border-dark);
  background: var(--panel-white);
  padding: 6px 14px;
  font-weight: 700;
  font-size: 12px;
  cursor: pointer;
  border-radius: 4px;
  color: var(--text-main);
  box-shadow: 1px 1px 0 #000000;
  transition: all 0.15s ease;
}

.nav-action-btn:hover {
  background: #422006;
}

/* Modal Overlay Styling */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  width: 100vw;
  height: 100vh;
  z-index: 9999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.modal-backdrop {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.8);
  backdrop-filter: blur(2px);
}

.modal-box {
  position: relative;
  z-index: 10000;
  background: var(--panel-white);
  border: var(--border-dark);
  border-radius: 12px;
  box-shadow: 6px 6px 0 #000000;
  padding: 20px;
  max-width: 380px;
  width: calc(100% - 32px);
  display: flex;
  flex-direction: column;
  gap: 16px;
  animation: modalPop 0.15s ease-out;
}

@keyframes modalPop {
  from { transform: scale(0.95); opacity: 0; }
  to { transform: scale(1); opacity: 1; }
}

.modal-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 2px solid #334155;
  padding-bottom: 10px;
}

.modal-header h3 {
  margin: 0;
  font-size: 16px;
  font-weight: 800;
}

.modal-close-btn {
  border: var(--border-dark);
  background: #450a0a;
  color: #fecaca;
  padding: 5px 12px;
  font-size: 12px;
  font-weight: 800;
  border-radius: 6px;
  cursor: pointer;
  box-shadow: 1px 1px 0 #000000;
}

.modal-close-btn:hover {
  background: #fca5a5;
}

.modal-body {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.qr-modal-img {
  width: 240px;
  height: 240px;
  object-fit: contain;
  border: var(--border-dark);
  border-radius: 8px;
  box-shadow: 3px 3px 0 #000000;
  background: var(--panel-white);
}

/* CA Sidebar Header */
.ca-sidebar-header {
  position: sticky;
  top: 0;
  background: var(--bg-cream);
  padding: 6px 12px;
  font-weight: 700;
  font-size: 11px;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.5px;
  border-radius: 4px;
  border: var(--border-light);
  z-index: 10;
  margin-top: 10px;
  margin-bottom: 2px;
}
.ca-sidebar-header:first-child {
  margin-top: 0;
}

/* Custom Scrollbar for tables/lists */
.custom-scrollbar::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
.custom-scrollbar::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.02);
  border-radius: 4px;
}
.custom-scrollbar::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.1);
  border-radius: 4px;
}
.custom-scrollbar::-webkit-scrollbar-thumb:hover {
  background: rgba(255, 255, 255, 0.2);
}
